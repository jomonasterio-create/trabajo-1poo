<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<VBox alignment="CENTER"
      spacing="20.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.monasterio.jose.jose.controller.UsuarioController">

    <Label text="Gestion de usuario" style="-fx-font-size: 18x"/>
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtId" promptText="Id" disable="true" prefWidth="40" />
        <TextField fx:id="txtNobre" promptText="Nombre de Usuario" prefWidth="100"/>
        <TextField fx:id="txtContrasena" promptText="Contraseña" prefWidth="100"/>
        <Button fx:id="BtnAgregar" onAction="#handleAgregarUsuario" text="Agregar" defaultButton="true"/>
        <Button fx:id="BtnEliminar" onAction="#handleEliminarUsuario" text="eliminar" disable="true"/>
    </HBox>

    <TableView fx:id="tableUsuarios" onMouseClicked="#handleSeleccionar">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colContrasena" text="Contraseña" />
        </columns>
    </TableView>
</VBox>
